    "NSScreenCaptureUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greedless Manager uses screen capture for Overview thumbnails, window drag previews, and Hidden Bar icons."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greedless Manager は、オーバービューのサムネイル、ウィンドウのドラッグプレビュー、隠しバーのアイコンのために画面収録を使用します。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greedless Manager verwendet Bildschirmaufnahmen für Vorschaubilder in der Übersicht, Vorschauen beim Ziehen von Fenstern und Symbole der versteckten Leiste."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greedless Manager bruker skjermopptak til miniatyrbilder i Oversikt, forhåndsvisninger ved vindusdraing og ikoner i Skjult linje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greedless Manager använder skärmfångst för miniatyrbilder i Översikt, förhandsvisningar vid fönsterdragning och ikoner i Hidden Bar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greedless Manager usa la captura de pantalla para las miniaturas de Vista general, las vistas previas al arrastrar ventanas y los iconos de Barra oculta."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greedless Manager 使用屏幕录制生成概览缩略图、窗口拖动预览和隐藏栏图标。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greedless Manager ओवरव्यू थंबनेल, विंडो ड्रैग प्रीव्यू और हिडन बार आइकन के लिए स्क्रीन कैप्चर का उपयोग करता है।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم Greedless Manager التقاط الشاشة لإنشاء الصور المصغرة لميزة «نظرة عامة»، ومعاينات سحب النوافذ، وأيقونات الشريط المخفي."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greedless Manager koristi snimanje ekrana za sličice Pregleda, prikaze pri prevlačenju prozora i ikone Skrivene trake."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Greedless Manager χρησιμοποιεί καταγραφή οθόνης για τις μικρογραφίες της Επισκόπησης, τις προεπισκοπήσεις μεταφοράς παραθύρων και τα εικονίδια της Κρυφής γραμμής."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greedless Manager משתמש בצילום מסך עבור תמונות ממוזערות ב-Overview, תצוגות מקדימות של גרירת חלונות וסמלים ב-Hidden Bar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greedless Manager использует захват экрана для миниатюр Overview, предварительного просмотра перетаскиваемых окон и значков Hidden Bar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greedless Manager korzysta z przechwytywania ekranu do miniatur w Overview, podglądu przeciąganych okien i ikon w Hidden Bar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greedless Manager використовує запис екрана для мініатюр Overview, попереднього перегляду під час перетягування вікон і піктограм Hidden Bar."
