        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greedless Manager käyttää näytön tallennusta Overview-pienoiskuviin, ikkunoiden vetämisen esikatseluun ja Hidden Bar -kuvakkeisiin."
